// 공장 초기 상태로 되돌리기 (처음 받았을 때 입력되던 글자 그대로)
//   [a][b][c][d]   위 노브: p(왼쪽) q(누름) r(오른쪽)
//   [e][f][g][h]   아래 노브: s(왼쪽) t(누름) u(오른쪽)
//   [i][j][k][l]
// 패드는 설정을 읽어오는 기능이 없어서, 이 파일이 "원래 상태" 백업 역할을 함.
{
  "layers": [
    {
      "buttons": [
        "a", "b", "c", "d",
        "e", "f", "g", "h",
        "i", "j", "k", "l"
      ],
      "knobs": [
        { "ccw": "p", "press": "q", "cw": "r" },
        { "ccw": "s", "press": "t", "cw": "u" }
      ]
    }
  ]
}
