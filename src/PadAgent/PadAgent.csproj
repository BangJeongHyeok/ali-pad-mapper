<Project Sdk="Microsoft.NET.Sdk">

  <!--
    트레이 상주 앱: PC 시작 시 자동 실행 → 패드가 보내는 F13~F24 등을 받아서
    프로그램 실행 / 단축키 묶음 / 문자열 입력 처리. 메뉴에서 패드에 설정 쓰기도 가능.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(MacroPadDotNet)-windows10.0.19041.0</TargetFramework>
    <!-- 재생 위치 이동(Windows 미디어 제어 API)이 Windows 10 1809 부터 있음 -->
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>PadAgent</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- 배포 폴더에 패키지 문서(xml)는 필요 없음 -->
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MacroPad.Core\MacroPad.Core.csproj" />
  </ItemGroup>

  <!-- 편집기 화면: WebView2(Windows 기본 Edge 엔진) 에 HTML/CSS 로 그림. 런타임이 없으면 기본 편집기로 대체 -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <!-- WinForms 만 쓰므로 패키지가 자동으로 넣는 WPF 용 참조는 뺌 (WindowsBase 버전 충돌 경고 방지) -->
  <Target Name="RemoveWebView2WpfReference" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

  <!-- 화면 파일(HTML/CSS/JS)은 exe 안에 넣어서 단일 파일 배포 유지 -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\ui\**\*" LinkBase="ui" LogicalName="ui/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- publish 할 때 예시 설정도 같이 복사 → 처음 실행할 때 macropad.json 으로 복사됨 (개발 중에는 솔루션 폴더의 macropad.json 을 바로 씀) -->
  <ItemGroup>
    <None Include="..\..\macropad.example.json" Link="macropad.example.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
